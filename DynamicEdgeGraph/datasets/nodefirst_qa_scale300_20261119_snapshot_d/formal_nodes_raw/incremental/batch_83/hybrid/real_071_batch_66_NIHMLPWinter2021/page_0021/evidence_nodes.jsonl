{"node_id": "real_071_batch_66_NIHMLPWinter2021_21_HY_006", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0010"], "source_fragment_ids": ["D0010_F001"], "source_visual_bundle_ids": [], "plain_text": "“Caring for patients during the\nCOVID-19 pandemic has shown us\nthe importance of communicating\nyour preferences, goals, and\nvalues for end-of-life care.\nWe want people to proactively\nthink about and make their\ncare preferences known before\nthey are seriously ill and unable\nto communicate their needs,”\nsays Dr. Miller. Being proactive,\nplanning, and sharing your\nchoices for care with your loved\nones and providers are helpful\nwhether you have COVID-19 or\nanother serious disease.", "semantic_text": "“Caring for patients during the COVID-19 pandemic has shown us the importance of communicating your preferences, goals, and values for end-of-life care. We want people to proactively think about and make their care preferences known before they are seriously ill and unable to communicate their needs,” says Dr. Miller. Being proactive, planning, and sharing your choices for care with your loved ones and providers are helpful whether you have COVID-19 or another serious disease.", "visual_description": null, "geometry_members": [{"member_id": "D0010_geometry", "bbox": [466, 791, 772, 1188], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0010"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_83/hybrid/real_071_batch_66_NIHMLPWinter2021/page_0021/decisions.json"}
