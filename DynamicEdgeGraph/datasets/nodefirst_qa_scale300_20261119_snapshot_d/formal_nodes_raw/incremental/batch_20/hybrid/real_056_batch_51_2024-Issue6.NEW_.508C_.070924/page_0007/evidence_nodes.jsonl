{"node_id": "real_056_batch_51_2024-Issue6.NEW_.508C_.070924_7_HY_001", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0006"], "source_fragment_ids": ["D0006_F001"], "source_visual_bundle_ids": [], "plain_text": "An otolaryngologist—also called an ear, nose, and throat doctor\n(ENT)—can diagnose taste disorders. The ENT will examine\nyour ears, nose, and throat and will ask about your health history.\nThey may recommend a dental exam to check your oral health.", "semantic_text": "An otolaryngologist—also called an ear, nose, and throat doctor (ENT)—can diagnose taste disorders. The ENT will examine your ears, nose, and throat and will ask about your health history. They may recommend a dental exam to check your oral health.", "visual_description": null, "geometry_members": [{"member_id": "D0006_geometry", "bbox": [68, 808, 596, 911], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0006"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_20/hybrid/real_056_batch_51_2024-Issue6.NEW_.508C_.070924/page_0007/decisions.json"}
