{"node_id": "short_002_geer_data_collection_user_guide_us_ed_2024_7_HY_009", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0014"], "source_fragment_ids": ["D0014_F001"], "source_visual_bundle_ids": [], "plain_text": "Multiple users may have access to the Data Collection Tool. If multiple users are entering data\non the same page of the APR at the same time, only the most recent data entry updates will be\ncaptured by the system. If, however, multiple users are working on different pages within the\nData Collection Tool at the same time, one user's save will not overwrite the other's. Users\nshould work internally to ensure multiple users are not saving updates to the APR concurrently.", "semantic_text": "Multiple users may have access to the Data Collection Tool. If multiple users are entering data on the same page of the APR at the same time, only the most recent data entry updates will be captured by the system. If, however, multiple users are working on different pages within the Data Collection Tool at the same time, one user's save will not overwrite the other's. Users should work internally to ensure multiple users are not saving updates to the APR concurrently.", "visual_description": null, "geometry_members": [{"member_id": "D0014_geometry", "bbox": [140, 1133, 1089, 1293], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0014"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_137/hybrid/short_002_geer_data_collection_user_guide_us_ed_2024/page_0007/decisions.json"}
