{"node_id": "real_062_batch_57_Volume18_Issue3-508.103023_8_HY_002", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0005"], "source_fragment_ids": ["D0005_F001"], "source_visual_bundle_ids": [], "plain_text": "The main symptoms of endometriosis are pelvic pain and\ninfertility or problems getting pregnant. This pain can\nhappen anytime and is usually worse during menstruation.\nOther common symptoms include:", "semantic_text": "The main symptoms of endometriosis are pelvic pain and infertility or problems getting pregnant. This pain can happen anytime and is usually worse during menstruation. Other common symptoms include:", "visual_description": null, "geometry_members": [{"member_id": "D0005_geometry", "bbox": [87, 357, 586, 474], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0005"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_38/hybrid/real_062_batch_57_Volume18_Issue3-508.103023/page_0008/decisions.json"}
