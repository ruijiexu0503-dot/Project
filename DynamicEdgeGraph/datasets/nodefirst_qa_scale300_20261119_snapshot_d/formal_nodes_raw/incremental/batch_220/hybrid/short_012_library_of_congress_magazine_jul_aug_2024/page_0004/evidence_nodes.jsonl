{"node_id": "short_012_library_of_congress_magazine_jul_aug_2024_4_HY_005", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0011"], "source_fragment_ids": ["D0011_F001"], "source_visual_bundle_ids": [], "plain_text": "The production and use of postcards\nexploded in the United States after a federal\nlaw, passed in 1907, allowed for messages\nto be written on the backs of the cards\nalong with the addresses. Previously,\npostcards were widely used, but messages\ncould only be added to the fronts of\ncards, which detracted from the images.", "semantic_text": "The production and use of postcards exploded in the United States after a federal law, passed in 1907, allowed for messages to be written on the backs of the cards along with the addresses. Previously, postcards were widely used, but messages could only be added to the fronts of cards, which detracted from the images.", "visual_description": null, "geometry_members": [{"member_id": "D0011_geometry", "bbox": [286, 1120, 708, 1288], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0011"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_220/hybrid/short_012_library_of_congress_magazine_jul_aug_2024/page_0004/decisions.json"}
