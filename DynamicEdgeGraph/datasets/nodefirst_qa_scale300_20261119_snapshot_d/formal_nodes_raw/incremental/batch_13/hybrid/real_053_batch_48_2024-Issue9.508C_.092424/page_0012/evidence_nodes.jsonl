{"node_id": "real_053_batch_48_2024-Issue9.508C_.092424_12_HY_001", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0004"], "source_fragment_ids": ["D0004_F001"], "source_visual_bundle_ids": [], "plain_text": "The good news is that SUDs are treatable. Like other chronic\nconditions, they can be managed effectively. Thanks to ongoing\nresearch, there are evidence-based methods to help people with\nSUDs improve their health and lives. While many people use\nother terms, this process is often known as being “in recovery”\nor “in remission.\n”", "semantic_text": "The good news is that SUDs are treatable. Like other chronic conditions, they can be managed effectively. Thanks to ongoing research, there are evidence-based methods to help people with SUDs improve their health and lives. While many people use other terms, this process is often known as being “in recovery” or “in remission. ”", "visual_description": null, "geometry_members": [{"member_id": "D0004_geometry", "bbox": [73, 154, 555, 307], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0004"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_13/hybrid/real_053_batch_48_2024-Issue9.508C_.092424/page_0012/decisions.json"}
