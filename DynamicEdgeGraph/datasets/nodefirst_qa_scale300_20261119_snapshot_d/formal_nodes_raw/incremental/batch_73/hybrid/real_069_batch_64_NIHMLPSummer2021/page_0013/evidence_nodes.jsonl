{"node_id": "real_069_batch_64_NIHMLPSummer2021_13_HY_009", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0013"], "source_fragment_ids": ["D0013_F001"], "source_visual_bundle_ids": [], "plain_text": "What is your message to others who\nhave epilepsy or other challenges?", "semantic_text": "What is your message to others who have epilepsy or other challenges?", "visual_description": null, "geometry_members": [{"member_id": "D0013_geometry", "bbox": [693, 833, 1111, 891], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0013"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_73/hybrid/real_069_batch_64_NIHMLPSummer2021/page_0013/decisions.json"}
{"node_id": "real_069_batch_64_NIHMLPSummer2021_13_HY_010", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0014"], "source_fragment_ids": ["D0014_F001"], "source_visual_bundle_ids": [], "plain_text": "Never lose hope. See yourself as someone strong.\nIf you believe in the beautiful inner light that all of\nus are born with, you can be whoever you want to be.\nDon't ever let anyone bring you down or stop you.\nIt is up to you to let your life shine and to go after\nyour dreams. No matter what your condition is,\nbelieve in yourself and love yourself.", "semantic_text": "Never lose hope. See yourself as someone strong. If you believe in the beautiful inner light that all of us are born with, you can be whoever you want to be. Don't ever let anyone bring you down or stop you. It is up to you to let your life shine and to go after your dreams. No matter what your condition is, believe in yourself and love yourself.", "visual_description": null, "geometry_members": [{"member_id": "D0014_geometry", "bbox": [693, 894, 1148, 1068], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0014"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_73/hybrid/real_069_batch_64_NIHMLPSummer2021/page_0013/decisions.json"}
{"node_id": "real_069_batch_64_NIHMLPSummer2021_13_HY_011", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0015"], "source_fragment_ids": ["D0015_F001"], "source_visual_bundle_ids": [], "plain_text": "Why is it important to promote that\nmessage on social media?", "semantic_text": "Why is it important to promote that message on social media?", "visual_description": null, "geometry_members": [{"member_id": "D0015_geometry", "bbox": [694, 1086, 1104, 1143], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0015"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_73/hybrid/real_069_batch_64_NIHMLPSummer2021/page_0013/decisions.json"}
{"node_id": "real_069_batch_64_NIHMLPSummer2021_13_HY_012", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0016"], "source_fragment_ids": ["D0016_F001"], "source_visual_bundle_ids": [], "plain_text": "Many people look at social media and see everyone\nelse's life as perfect. They compare themselves to\nthis and think their lives are not good. They need to\nunderstand that social media is a filter. I see sharing\nmy struggles as an important part of my role, to show\npeople that we all go through challenges and that life\nis never perfect.", "semantic_text": "Many people look at social media and see everyone else's life as perfect. They compare themselves to this and think their lives are not good. They need to understand that social media is a filter. I see sharing my struggles as an important part of my role, to show people that we all go through challenges and that life is never perfect.", "visual_description": null, "geometry_members": [{"member_id": "D0016_geometry", "bbox": [694, 1145, 1150, 1322], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0016"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_73/hybrid/real_069_batch_64_NIHMLPSummer2021/page_0013/decisions.json"}
