{"node_id": "real_049_MedlinePlus-Magazine-2024-Issue1_12_HY_002", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0006"], "source_fragment_ids": ["D0006_F001"], "source_visual_bundle_ids": [], "plain_text": "Traditional allergy shots, also called allergen immunotherapy,\nare a common treatment for cat allergies. These shots slowly\nmake you less sensitive to allergens, which eases symptoms over\ntime. But they can take a long time to work, and they don't work\nfor everyone.", "semantic_text": "Traditional allergy shots, also called allergen immunotherapy, are a common treatment for cat allergies. These shots slowly make you less sensitive to allergens, which eases symptoms over time. But they can take a long time to work, and they don't work for everyone.", "visual_description": null, "geometry_members": [{"member_id": "D0006_geometry", "bbox": [75, 511, 607, 639], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0006"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_2/hybrid/real_049_MedlinePlus-Magazine-2024-Issue1/page_0012/decisions.json"}
