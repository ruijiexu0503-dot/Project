{"node_id": "real_049_MedlinePlus-Magazine-2024-Issue1_12_HY_005", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0010"], "source_fragment_ids": ["D0010_F001"], "source_visual_bundle_ids": [], "plain_text": "different treatment groups. One group received a medication\ncalled tezepelumab in addition to traditional allergy shots.\nThe rest got allergy shots alone, tezepelumab alone, or placebo\nfor both (placebos are inactive substances that look like\nreal medicine).", "semantic_text": "different treatment groups. One group received a medication called tezepelumab in addition to traditional allergy shots. The rest got allergy shots alone, tezepelumab alone, or placebo for both (placebos are inactive substances that look like real medicine).", "visual_description": null, "geometry_members": [{"member_id": "D0010_geometry", "bbox": [632, 559, 1138, 688], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0010"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_2/hybrid/real_049_MedlinePlus-Magazine-2024-Issue1/page_0012/decisions.json"}
{"node_id": "real_049_MedlinePlus-Magazine-2024-Issue1_12_HY_006", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0013"], "source_fragment_ids": ["D0013_F001"], "source_visual_bundle_ids": [], "plain_text": "Participants who received the combined treatment had less\nsevere symptoms when exposed to cat allergens than those\nwho got the allergy shot alone. The study also found that some\nbenefits of the combined treatment lasted for at least one year\nafter treatment ended.", "semantic_text": "Participants who received the combined treatment had less severe symptoms when exposed to cat allergens than those who got the allergy shot alone. The study also found that some benefits of the combined treatment lasted for at least one year after treatment ended.", "visual_description": null, "geometry_members": [{"member_id": "D0013_geometry", "bbox": [632, 691, 1137, 819], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0013"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_2/hybrid/real_049_MedlinePlus-Magazine-2024-Issue1/page_0012/decisions.json"}
{"node_id": "real_049_MedlinePlus-Magazine-2024-Issue1_12_HY_007", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0016"], "source_fragment_ids": ["D0016_F001"], "source_visual_bundle_ids": [], "plain_text": "Cat allergens are tiny proteins found in cat skin,\nsaliva, and urine. It's the allergens (and not the\ncat itself!) that can cause allergic reactions in\nhumans who encounter them. Cat dander can\nstill cause allergies even if the cat is not around.", "semantic_text": "Cat allergens are tiny proteins found in cat skin, saliva, and urine. It's the allergens (and not the cat itself!) that can cause allergic reactions in humans who encounter them. Cat dander can still cause allergies even if the cat is not around.", "visual_description": null, "geometry_members": [{"member_id": "D0016_geometry", "bbox": [195, 951, 580, 1100], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0016"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_2/hybrid/real_049_MedlinePlus-Magazine-2024-Issue1/page_0012/decisions.json"}
