{"node_id": "short_005_ncah_portal_user_guide_13_usda_2025_7_HY_005", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0008"], "source_fragment_ids": ["D0008_F001"], "source_visual_bundle_ids": [], "plain_text": "It is not necessary to specify a paper size for which you have the paper/printer available to print hard copies\nas the label submission is an entirely electronic process. However, if you do need to print the oversized page\nfor your records, print using the Poster setting of Adobe Acrobat PRO. With this feature, the document\ncontent is divided into multiple pages of standard-sized paper, which can be pieced together once printed.", "semantic_text": "It is not necessary to specify a paper size for which you have the paper/printer available to print hard copies as the label submission is an entirely electronic process. However, if you do need to print the oversized page for your records, print using the Poster setting of Adobe Acrobat PRO. With this feature, the document content is divided into multiple pages of standard-sized paper, which can be pieced together once printed.", "visual_description": null, "geometry_members": [{"member_id": "D0008_geometry", "bbox": [67, 557, 1143, 675], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0008"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_159/hybrid/short_005_ncah_portal_user_guide_13_usda_2025/page_0007/decisions.json"}
