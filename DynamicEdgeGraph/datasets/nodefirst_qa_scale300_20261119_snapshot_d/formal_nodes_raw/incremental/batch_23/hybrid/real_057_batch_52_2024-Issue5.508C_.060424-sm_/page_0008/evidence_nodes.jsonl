{"node_id": "real_057_batch_52_2024-Issue5.508C_.060424-sm__8_HY_008", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0011"], "source_fragment_ids": ["D0011_F001"], "source_visual_bundle_ids": [], "plain_text": "Simple steps for happy feet", "semantic_text": "Simple steps for happy feet", "visual_description": null, "geometry_members": [{"member_id": "D0011_geometry", "bbox": [69, 771, 375, 803], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0011"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_23/hybrid/real_057_batch_52_2024-Issue5.508C_.060424-sm_/page_0008/decisions.json"}
{"node_id": "real_057_batch_52_2024-Issue5.508C_.060424-sm__8_HY_009", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0012"], "source_fragment_ids": ["D0012_F001"], "source_visual_bundle_ids": [], "plain_text": "■ Wash your feet every day. Use soap and water and dry them\nthoroughly, especially between the toes. A warm foot bath can be\na relaxing treat! Moisturize any dry, rough, or cracked areas (such\nas the heels) and put on clean, dry socks when you're done.\n■ Check your feet often. Look for any cuts, sores, blisters, or\nchanges in skin color. If you have diabetes, pay special attention\nto your feet, and see your doctor regularly for checkups.", "semantic_text": "■ Wash your feet every day. Use soap and water and dry them thoroughly, especially between the toes. A warm foot bath can be a relaxing treat! Moisturize any dry, rough, or cracked areas (such as the heels) and put on clean, dry socks when you're done. ■ Check your feet often. Look for any cuts, sores, blisters, or changes in skin color. If you have diabetes, pay special attention to your feet, and see your doctor regularly for checkups.", "visual_description": null, "geometry_members": [{"member_id": "D0012_geometry", "bbox": [81, 811, 602, 987], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0012"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_23/hybrid/real_057_batch_52_2024-Issue5.508C_.060424-sm_/page_0008/decisions.json"}
