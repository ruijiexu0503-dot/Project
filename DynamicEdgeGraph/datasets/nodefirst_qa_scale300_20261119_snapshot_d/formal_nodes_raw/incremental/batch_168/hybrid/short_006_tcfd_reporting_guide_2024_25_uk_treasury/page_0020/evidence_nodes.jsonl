{"node_id": "short_006_tcfd_reporting_guide_2024_25_uk_treasury_20_HY_008", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0010"], "source_fragment_ids": ["D0010_F001"], "source_visual_bundle_ids": [], "plain_text": "Strategy disclosures enable report users to understand the principal\nclimate-related risks and opportunities an organisation faces, how well\npositioned it is to capitalise on emerging opportunities, and how resilient its\nstrategy and financial position are to climate-related risks under different\nplausible climate futures. By showing how those insights are integrated into\nlong-term planning and decision-making, they allow users to assess the\nadequacy of the actions by those charged with governance.", "semantic_text": "Strategy disclosures enable report users to understand the principal climate-related risks and opportunities an organisation faces, how well positioned it is to capitalise on emerging opportunities, and how resilient its strategy and financial position are to climate-related risks under different plausible climate futures. By showing how those insights are integrated into long-term planning and decision-making, they allow users to assess the adequacy of the actions by those charged with governance.", "visual_description": null, "geometry_members": [{"member_id": "D0010_geometry", "bbox": [70, 1276, 1085, 1533], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0010"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_168/hybrid/short_006_tcfd_reporting_guide_2024_25_uk_treasury/page_0020/decisions.json"}
