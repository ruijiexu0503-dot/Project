{"node_id": "short_017_paperless_express_epa_business_guide_9_HY_003", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0005"], "source_fragment_ids": ["D0005_F001"], "source_visual_bundle_ids": [], "plain_text": "Consider lighter-weight paper. Less\nweight means less paper.", "semantic_text": "Consider lighter-weight paper. Less weight means less paper.", "visual_description": null, "geometry_members": [{"member_id": "D0005_geometry", "bbox": [452, 338, 764, 388], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0005"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_261/hybrid/short_017_paperless_express_epa_business_guide/page_0009/decisions.json"}
{"node_id": "short_017_paperless_express_epa_business_guide_9_HY_004", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0006"], "source_fragment_ids": ["D0006_F001"], "source_visual_bundle_ids": [], "plain_text": "Reduce trim size. Shaving a 3⁄4 inch\noff your book, magazine, or catalog\ncould save thousands of pounds of\npaper per year. Lower weight also\nreduces postage costs.", "semantic_text": "Reduce trim size. Shaving a 3⁄4 inch off your book, magazine, or catalog could save thousands of pounds of paper per year. Lower weight also reduces postage costs.", "visual_description": null, "geometry_members": [{"member_id": "D0006_geometry", "bbox": [452, 403, 767, 532], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0006"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_261/hybrid/short_017_paperless_express_epa_business_guide/page_0009/decisions.json"}
{"node_id": "short_017_paperless_express_epa_business_guide_9_HY_005", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0007"], "source_fragment_ids": ["D0007_F001"], "source_visual_bundle_ids": [], "plain_text": "Minimize paper waste when using\n“bleeds”. A bleed is when text, color,\nor graphic elements extend to the\nedge of the printed page. To achieve\nthis, printers print pages on oversized\npaper and cut off the unused margins\nto the final trim size, thus creating\nwaste. Work with your designer and\nprinter so your designs use the sheet\nsize efficiently.", "semantic_text": "Minimize paper waste when using “bleeds”. A bleed is when text, color, or graphic elements extend to the edge of the printed page. To achieve this, printers print pages on oversized paper and cut off the unused margins to the final trim size, thus creating waste. Work with your designer and printer so your designs use the sheet size efficiently.", "visual_description": null, "geometry_members": [{"member_id": "D0007_geometry", "bbox": [452, 545, 783, 807], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0007"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_261/hybrid/short_017_paperless_express_epa_business_guide/page_0009/decisions.json"}
{"node_id": "short_017_paperless_express_epa_business_guide_9_HY_006", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0008"], "source_fragment_ids": ["D0008_F001"], "source_visual_bundle_ids": [], "plain_text": "Reduce print runs. Try to specify\nquantities you're sure you need.", "semantic_text": "Reduce print runs. Try to specify quantities you're sure you need.", "visual_description": null, "geometry_members": [{"member_id": "D0008_geometry", "bbox": [452, 820, 740, 871], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0008"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_261/hybrid/short_017_paperless_express_epa_business_guide/page_0009/decisions.json"}
