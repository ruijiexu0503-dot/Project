{"node_id": "real_071_batch_66_NIHMLPWinter2021_12_HY_003", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0005"], "source_fragment_ids": ["D0005_F001"], "source_visual_bundle_ids": [], "plain_text": "Retired National Football\nLeague (NFL) defensive\nsuperstar DeMarcus Ware won\nmillions of fans with his ability\nto conquer and defeat opposing\nteams. Now, the former Dallas\nCowboy and Denver Bronco\nAll-Pro has a new starring\nrole: helping others improve\ntheir fitness and health. He\nspoke about what keeps him\nmotivated, his favorite healthy\nsnack, and how he and his\nfamily lead healthy lives.", "semantic_text": "Retired National Football League (NFL) defensive superstar DeMarcus Ware won millions of fans with his ability to conquer and defeat opposing teams. Now, the former Dallas Cowboy and Denver Bronco All-Pro has a new starring role: helping others improve their fitness and health. He spoke about what keeps him motivated, his favorite healthy snack, and how he and his family lead healthy lives.", "visual_description": null, "geometry_members": [{"member_id": "D0005_geometry", "bbox": [100, 620, 391, 971], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0005"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_81/hybrid/real_071_batch_66_NIHMLPWinter2021/page_0012/decisions.json"}
