{"node_id": "real_071_batch_66_NIHMLPWinter2021_14_HY_001", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0004"], "source_fragment_ids": ["D0004_F001"], "source_visual_bundle_ids": [], "plain_text": "Regular physical activity is great for your mental and physical health. It also helps you stay independent\nas you age. The Physical Activity Guidelines for Americans recommend that you aim to exercise at\nleast 150 minutes every week at a moderate pace, or 75 at a more vigorous pace. The guidelines also\nrecommend that older adults do muscle-strengthening activities at least two days a week.", "semantic_text": "Regular physical activity is great for your mental and physical health. It also helps you stay independent as you age. The Physical Activity Guidelines for Americans recommend that you aim to exercise at least 150 minutes every week at a moderate pace, or 75 at a more vigorous pace. The guidelines also recommend that older adults do muscle-strengthening activities at least two days a week.", "visual_description": null, "geometry_members": [{"member_id": "D0004_geometry", "bbox": [194, 434, 1049, 534], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0004"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_81/hybrid/real_071_batch_66_NIHMLPWinter2021/page_0014/decisions.json"}
