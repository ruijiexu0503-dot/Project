{"node_id": "real_050_MedlinePlus-Magazine-2024-Issue11_1_HY_003", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0004"], "source_fragment_ids": ["D0004_F001"], "source_visual_bundle_ids": [], "plain_text": "Some people inherit heirlooms—jewelry, furniture, clothing,\nand other items—from their relatives. But there's something\neven more valuable we all inherit: our health.", "semantic_text": "Some people inherit heirlooms—jewelry, furniture, clothing, and other items—from their relatives. But there's something even more valuable we all inherit: our health.", "visual_description": null, "geometry_members": [{"member_id": "D0004_geometry", "bbox": [69, 863, 601, 939], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0004"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_3/hybrid/real_050_MedlinePlus-Magazine-2024-Issue11/page_0001/decisions.json"}
{"node_id": "real_050_MedlinePlus-Magazine-2024-Issue11_1_HY_004", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0005"], "source_fragment_ids": ["D0005_F001"], "source_visual_bundle_ids": [], "plain_text": "Finding out what medical conditions run in your family is one of\nthe best ways to predict your risk for certain diseases. Relatives often\nget together around the holidays, so this time of year can be a good\nopportunity to learn about your family health history.", "semantic_text": "Finding out what medical conditions run in your family is one of the best ways to predict your risk for certain diseases. Relatives often get together around the holidays, so this time of year can be a good opportunity to learn about your family health history.", "visual_description": null, "geometry_members": [{"member_id": "D0005_geometry", "bbox": [70, 944, 588, 1047], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0005"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_3/hybrid/real_050_MedlinePlus-Magazine-2024-Issue11/page_0001/decisions.json"}
