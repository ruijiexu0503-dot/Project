{"node_id": "real_061_batch_56_Volume18_Issue4-508C-small_9_HY_015", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0021"], "source_fragment_ids": ["D0021_F001"], "source_visual_bundle_ids": [], "plain_text": "ADHD wasn't called \"ADHD\" until the late 1980s.", "semantic_text": "ADHD wasn't called \"ADHD\" until the late 1980s.", "visual_description": null, "geometry_members": [{"member_id": "D0021_geometry", "bbox": [654, 1128, 1128, 1164], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0021"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_32/hybrid/real_061_batch_56_Volume18_Issue4-508C-small/page_0009/decisions.json"}
