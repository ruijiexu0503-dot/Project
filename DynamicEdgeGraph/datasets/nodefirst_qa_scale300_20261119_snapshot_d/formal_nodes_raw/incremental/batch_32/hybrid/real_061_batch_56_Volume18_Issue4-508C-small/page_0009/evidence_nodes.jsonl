{"node_id": "real_061_batch_56_Volume18_Issue4-508C-small_9_HY_017", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0023"], "source_fragment_ids": ["D0023_F001"], "source_visual_bundle_ids": [], "plain_text": "One of the earliest accounts of hyperactivity was from 1798,\nwhen a Scottish physician observed a condition of “mental\nrestlessness” and “the fidgets” in children that closely resembles\nwhat we now call ADHD. The condition was later referred to as\n“minimal brain dysfunction” in the 1950s, “hyperkinetic reaction\nof childhood” in the 1970s, and finally “attention-deficit/\nhyperactivity disorder” in the 1980s.", "semantic_text": "One of the earliest accounts of hyperactivity was from 1798, when a Scottish physician observed a condition of “mental restlessness” and “the fidgets” in children that closely resembles what we now call ADHD. The condition was later referred to as “minimal brain dysfunction” in the 1950s, “hyperkinetic reaction of childhood” in the 1970s, and finally “attention-deficit/ hyperactivity disorder” in the 1980s.", "visual_description": null, "geometry_members": [{"member_id": "D0023_geometry", "bbox": [643, 1235, 1153, 1430], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0023"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_32/hybrid/real_061_batch_56_Volume18_Issue4-508C-small/page_0009/decisions.json"}
