{"node_id": "real_067_batch_62_NIH_MedlinePlus_MagazineWinter2022_16_HY_004", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0008"], "source_fragment_ids": ["D0008_F001"], "source_visual_bundle_ids": [], "plain_text": "Relapsing polychondritis — “RP” for short — causes\nwidespread inflammation (pain and swelling). It also breaks\ndown cartilage (the tissue that protects your bones and\njoints) in certain parts of the body.", "semantic_text": "Relapsing polychondritis — “RP” for short — causes widespread inflammation (pain and swelling). It also breaks down cartilage (the tissue that protects your bones and joints) in certain parts of the body.", "visual_description": null, "geometry_members": [{"member_id": "D0008_geometry", "bbox": [100, 657, 599, 761], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0008"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_67/hybrid/real_067_batch_62_NIH_MedlinePlus_MagazineWinter2022/page_0016/decisions.json"}
