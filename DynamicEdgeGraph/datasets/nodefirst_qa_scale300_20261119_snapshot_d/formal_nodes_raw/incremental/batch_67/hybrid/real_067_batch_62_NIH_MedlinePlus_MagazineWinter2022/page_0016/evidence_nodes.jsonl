{"node_id": "real_067_batch_62_NIH_MedlinePlus_MagazineWinter2022_16_HY_002", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0004", "D0005", "D0006"], "source_fragment_ids": ["D0004_F001", "D0005_F001", "D0006_F001"], "source_visual_bundle_ids": [], "plain_text": "The first sign Meredith Winchell noticed was\ntrouble breathing. At the time, she worked as an\nanalyst at NIH. First, she started losing her breath\njust walking down a hallway at work. Then new symptoms\nstarted showing up, and they kept getting\nworse. Five years later, after countless\ndoctor's visits, diagnostic tests, and trips\nto the emergency room, she was diagnosed\nwith a rare disease called relapsing polychondritis.", "semantic_text": "The first sign Meredith Winchell noticed was trouble breathing. At the time, she worked as an analyst at NIH. First, she started losing her breath just walking down a hallway at work. Then new symptoms\nstarted showing up, and they kept getting worse. Five years later, after countless doctor's visits, diagnostic tests, and trips to the emergency room, she was diagnosed\nwith a rare disease called relapsing polychondritis.", "visual_description": null, "geometry_members": [{"member_id": "D0004_geometry", "bbox": [99, 408, 602, 527], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0004"}, {"member_id": "D0005_geometry", "bbox": [231, 529, 591, 630], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0005"}, {"member_id": "D0006_geometry", "bbox": [100, 631, 518, 656], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0006"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_pre