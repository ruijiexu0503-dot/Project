{"node_id": "real_054_batch_49_2024-Issue8.508C_.090424_12_HY_008", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0014"], "source_fragment_ids": ["D0014_F001"], "source_visual_bundle_ids": [], "plain_text": "■ Choose easy-to-wear clothes and shoes, such as those\nwith Velcro or slip-ons.\n■ Reduce or eliminate caffeine and other stimulants.\n■ Talk with your doctor about trying medications to suppress\nyour tremors or stopping medications that might worsen them.\n■ If your doctor prescribes medications to help your tremors,\ntake them on time.\n■ Reduce stress and get enough sleep.", "semantic_text": "■ Choose easy-to-wear clothes and shoes, such as those with Velcro or slip-ons. ■ Reduce or eliminate caffeine and other stimulants. ■ Talk with your doctor about trying medications to suppress your tremors or stopping medications that might worsen them. ■ If your doctor prescribes medications to help your tremors, take them on time. ■ Reduce stress and get enough sleep.", "visual_description": null, "geometry_members": [{"member_id": "D0014_geometry", "bbox": [643, 522, 1149, 725], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0014"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_prepared_incremental_non_nasa_after_all_parse_20261119/batch_16/hybrid/real_054_batch_49_2024-Issue8.508C_.090424/page_0012/decisions.json"}
