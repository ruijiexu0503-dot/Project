{"node_id": "real_068_batch_63_NIHMLPFall2021_15_HY_002", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0003"], "source_fragment_ids": ["D0003_F001"], "source_visual_bundle_ids": [], "plain_text": "These findings are especially\nimportant today with the Delta\nvariant strain of the COVID-19\nvirus. We now know that pregnant\nand lactating people who are half\nvaccinated are hardly protected\nagainst it, so it's extremely important\nfor them to be cautious until they are\nfully vaccinated.", "semantic_text": "These findings are especially important today with the Delta variant strain of the COVID-19 virus. We now know that pregnant and lactating people who are half vaccinated are hardly protected against it, so it's extremely important for them to be cautious until they are fully vaccinated.", "visual_description": null, "geometry_members": [{"member_id": "D0003_geometry", "bbox": [103, 472, 424, 698], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0003"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_snapshot_non_nasa_20261118_2243_v2/batch_25/hybrid/real_068_batch_63_NIHMLPFall2021/page_0015/decisions.json"}
