{"node_id": "real_071_batch_66_NIHMLPWinter2021_2_HY_001", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0002"], "source_fragment_ids": ["D0002_F001"], "source_visual_bundle_ids": [], "plain_text": "THE NATIONAL HEART, LUNG, AND\nBLOOD INSTITUTE (NHLBI) is excited to\nwork with the National Library of Medicine on\nNIH MedlinePlus magazine to highlight important\nresearch on physical activity and heart health.", "semantic_text": "THE NATIONAL HEART, LUNG, AND BLOOD INSTITUTE (NHLBI) is excited to work with the National Library of Medicine on NIH MedlinePlus magazine to highlight important research on physical activity and heart health.", "visual_description": null, "geometry_members": [{"member_id": "D0002_geometry", "bbox": [156, 340, 585, 467], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0002"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_snapshot_non_nasa_20261118_2243_v2/batch_37/hybrid/real_071_batch_66_NIHMLPWinter2021/page_0002/decisions.json"}
{"node_id": "real_071_batch_66_NIHMLPWinter2021_2_HY_002", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0003"], "source_fragment_ids": ["D0003_F001"], "source_visual_bundle_ids": [], "plain_text": "The magazine's cover star is DeMarcus Ware, a\nformer National Football League player who has\ntranslated his passion for fitness off the field. In\naddition to lifting weights and working out in the\ngym, Ware gets moving with his two kids and has\ncut a rug in “Dancing with the Stars,” blending\nfitness with family time and fun.", "semantic_text": "The magazine's cover star is DeMarcus Ware, a former National Football League player who has translated his passion for fitness off the field. In addition to lifting weights and working out in the gym, Ware gets moving with his two kids and has cut a rug in “Dancing with the Stars,” blending fitness with family time and fun.", "visual_description": null, "geometry_members": [{"member_id": "D0003_geometry", "bbox": [157, 468, 576, 641], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0003"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_snapshot_non_nasa_20261118_2243_v2/batch_37/hybrid/real_071_batch_66_NIHMLPWinter2021/page_0002/decisions.json"}
