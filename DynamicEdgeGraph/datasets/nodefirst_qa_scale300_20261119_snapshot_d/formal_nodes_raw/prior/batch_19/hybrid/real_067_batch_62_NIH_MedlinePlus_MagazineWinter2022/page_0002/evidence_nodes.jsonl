{"node_id": "real_067_batch_62_NIH_MedlinePlus_MagazineWinter2022_2_HY_001", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0003"], "source_fragment_ids": ["D0003_F001"], "source_visual_bundle_ids": [], "plain_text": "WELCOME TO THE WINTER 2022 ISSUE OF\nNIH MEDLINEPLUS MAGAZINE. This issue\nfeatures guidance and research from the National\nInstitutes of Health on topics including rare diseases,\nasthma, and mental health, featuring an interview\nwith award-winning actress Taraji P. Henson.", "semantic_text": "WELCOME TO THE WINTER 2022 ISSUE OF NIH MEDLINEPLUS MAGAZINE. This issue features guidance and research from the National Institutes of Health on topics including rare diseases, asthma, and mental health, featuring an interview with award-winning actress Taraji P. Henson.", "visual_description": null, "geometry_members": [{"member_id": "D0003_geometry", "bbox": [150, 352, 605, 509], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0003"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_snapshot_non_nasa_20261118_2243_v2/batch_19/hybrid/real_067_batch_62_NIH_MedlinePlus_MagazineWinter2022/page_0002/decisions.json"}
{"node_id": "real_067_batch_62_NIH_MedlinePlus_MagazineWinter2022_2_HY_002", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0004"], "source_fragment_ids": ["D0004_F001"], "source_visual_bundle_ids": [], "plain_text": "Best known for her leading roles in the TV show\n“Empire” and the movie “Hidden Figures,” Henson\nrecently opened up about her personal struggles\nwith mental health. By sharing her story and starting\na Facebook Watch video series about dealing with\nmental health, Henson is destigmatizing a health\nissue that affects more Americans than ever.", "semantic_text": "Best known for her leading roles in the TV show “Empire” and the movie “Hidden Figures,” Henson recently opened up about her personal struggles with mental health. By sharing her story and starting a Facebook Watch video series about dealing with mental health, Henson is destigmatizing a health issue that affects more Americans than ever.", "visual_description": null, "geometry_members": [{"member_id": "D0004_geometry", "bbox": [151, 510, 597, 690], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0004"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_snapshot_non_nasa_20261118_2243_v2/batch_19/hybrid/real_067_batch_62_NIH_MedlinePlus_MagazineWinter2022/page_0002/decisions.json"}
{"node_id": "real_067_batch_62_NIH_MedlinePlus_MagazineWinter2022_2_HY_003", "node_type": "evidence", "status": "HYBRID_SHADOW_CANDIDATE", "unit_type": "TEXT", "source_atom_ids": ["D0005"], "source_fragment_ids": ["D0005_F001"], "source_visual_bundle_ids": [], "plain_text": "During the last two years of the pandemic, over\n30% of American adults reported experiencing\nsymptoms of anxiety. Isolation, financial strain,\nand health concerns have had a negative impact on\nthe mental health of many people. Learn how to\nunwind at home with NIH resources like the guided\nvisualization video highlighted in this issue.", "semantic_text": "During the last two years of the pandemic, over 30% of American adults reported experiencing symptoms of anxiety. Isolation, financial strain, and health concerns have had a negative impact on the mental health of many people. Learn how to unwind at home with NIH resources like the guided visualization video highlighted in this issue.", "visual_description": null, "geometry_members": [{"member_id": "D0005_geometry", "bbox": [150, 691, 593, 873], "bbox_source": "dolphin_v2_resized_image_pixels", "source_atom_id": "D0005"}], "native_visual_components": [], "production_modified": false, "visual_description_status": "UNVERIFIED_RETRIEVAL_HINT", "node_policy": "bounded-v2", "scoring_mode": "embedding_geometry", "hybrid_model_decision_file": "/hkfs/home/project/hk-project-p0025545/dv3352/Project/remote_runs/node-first-realpdf-20261118/output/nodes_snapshot_non_nasa_20261118_2243_v2/batch_19/hybrid/real_067_batch_62_NIH_MedlinePlus_MagazineWinter2022/page_0002/decisions.json"}
